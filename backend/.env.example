# Server
PORT=3000

# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>

# JWT — згенеруй надійний рандомний рядок (мін. 32 символи)
JWT_SECRET=

# Секретний код для реєстрації нових адмінів (макс. 3 акаунти)
ADMIN_REGISTER_CODE=0TRkOXdw31g

# Cloudinary — для зберігання фото
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# DeepL — для автоперекладу (опціонально)
# Без цього ключа контент зберігається лише мовою оригіналу
DEEPL_API_KEY=

# CORS — вкажи URL свого фронтенду на Vercel
# Без цього — всі origins дозволені (небезпечно у production)
ALLOWED_ORIGIN=https://your-app.vercel.app
